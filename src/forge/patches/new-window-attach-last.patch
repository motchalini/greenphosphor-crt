+   * (or are about to be) part of the layout; when none qualify, any live
+   * window wins so the container fallback stays a last resort.
+   * @param {import("./tree.js").Node} metaMonWsNode
+   * @returns {import("./tree.js").Node|null} anchor window node, null when empty
+   */
+  _lastAttachAnchor(metaMonWsNode) {
+    const windows = [];
+    metaMonWsNode._walk((node) => {
+      if (node.isWindow() && Utils.isWindowAlive(node.nodeValue)) windows.push(node);
+    }, metaMonWsNode._traverseDepthFirst);
+    // isTile() can't be the predicate here: a window created moments ago is
+    // still FLOAT until processFloats runs (the forge-3hsv trap), so a burst
+    // of new windows would anchor before their predecessor. isFloatingExempt
+    // reads what is knowable now; minimized windows are excluded like every
+    // other "really in the layout" check (getTiledChildren et al.) so a
+    // hidden window's slot is never split out from under it.
+    const anchorable = windows.filter(
+      (w) => !this.isFloatingExempt(w.nodeValue) && !w.nodeValue.minimized
+    );
